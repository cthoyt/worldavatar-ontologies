        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Velocity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/inDanger -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/inDanger">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/EnvironmentComponentUnionInfrastructureComponentUnionPopulation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
