<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.theworldavatar.com/kg/ontolandslide/"
     xml:base="http://www.theworldavatar.com/kg/ontolandslide/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ontolandslide="http://www.theworldavatar.com/kg/ontolandslide/">
    <owl:Ontology rdf:about="http://www.theworldavatar.com/kg/ontolandslide/">
        <dc:date>04 September 2026</dc:date>
        <gitCommitHash>c0599beca8df55873a1ab061dee64e52c510c6a0</gitCommitHash>
        <rdfs:comment>OntoLandslide is an ontology developed to represent landslide hazard</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/gitCommitHash -->


    <owl:AnnotationProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/gitCommitHash"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/actionTaken -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/actionTaken">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Response"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/ResponseAction"/>
        <rdfs:comment>Specifies the actions taken in response to a landslide.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>action Taken</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/affects -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/affects">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Wildfire"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/EnvironmentComponentUnionInfrastructureComponentUnionPopulation"/>
        <rdfs:comment>Indicates the components (environment, infrastructure, population) affected by an event like a wildfire or landslide.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/currentWarningSign -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/currentWarningSign">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/LandslideSpot"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/WarningSign"/>
        <rdfs:comment>Associates a landslide spot with its current warning sign.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>current Warning Sign</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasBeginning -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasBeginning">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Interval"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Instant"/>
        <rdfs:comment>Defines the starting instant of an interval.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Beginning</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasCausalFactor -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasCausalFactor">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Event"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/CausalFactor"/>
        <rdfs:comment>Identifies the causal factor responsible for an event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Causal Factor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasDataSource -->


