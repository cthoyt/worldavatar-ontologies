    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasDataSourceMetadata">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/DataSource"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/DataSourceMetadata"/>
        <rdfs:comment>Links a data source to its metadata.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Data Source Metadata</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasEnd -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasEnd">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Interval"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Instant"/>
        <rdfs:comment>Defines the ending instant of an interval.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has End</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasFileUrl -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasFileUrl">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/ShapeFile"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/FileUrl"/>
        <rdfs:comment>Points to the URL of the shapefile.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has File Url</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasForecastLocation -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasForecastLocation">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/LandslideForecast"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Location"/>
        <rdfs:comment>Specifies the location for which a landslide forecast is made.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Forecast Location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasGeometry -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasGeometry">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Location"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment>Indicates the geometric representation of a location.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Geometry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasInputParameter -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasInputParameter">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/LandslideForecast"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/InputParameter"/>
        <rdfs:comment>Identifies the input parameters used for landslide forecasting.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Input Parameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasLandslideHistory -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasLandslideHistory">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Location"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/LandslideHistory"/>
        <rdfs:comment>Connects a location to its associated landslide history.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Landslide History</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasLocation -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasLocation">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Event"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Location"/>
        <rdfs:comment>Links an event to the geographic location where it occurred.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasResponse -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasResponse">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Landslide"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Response"/>
        <rdfs:comment>Associates a landslide event with the response taken.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Response</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasSeverity -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasSeverity">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/WarningSign"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Severity"/>
        <rdfs:comment>Links a warning sign to its severity level.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasShapeFile -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasShapeFile">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Location"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/ShapeFile"/>
        <rdfs:comment>Refers to the shapefile associated with a specific location.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Shape File</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasTimeInterval -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasTimeInterval">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Event"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Interval"/>
        <rdfs:comment>Specifies the time interval during which an event occurred.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Time Interval</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasTimeSeries -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasTimeSeries">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/LandslideHistory"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/TimeSeries"/>
        <rdfs:comment>Associates landslide history with a time series of data points.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Time Series</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasWarningHistory -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasWarningHistory">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/LandslideSpot"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/LandslideWarningHistory"/>
        <rdfs:comment>Links a landslide spot to its warning history.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Warning History</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasWarningTimeSeries -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasWarningTimeSeries">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/LandslideWarningHistory"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/TimeSeries"/>
        <rdfs:comment>Associates landslide warning history with a time series of warning data.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Warning Time Series</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasWaterContent -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasWaterContent">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Slope/Soil/GeologicalLayer"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/WaterContent"/>
        <rdfs:comment>Links a geological layer to its water content.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Water Content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/isProducedBy -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/isProducedBy">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/ShapeFile"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Organization"/>
