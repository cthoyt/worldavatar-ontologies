    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasCollapsed -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasCollapsed">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/InfrastructureComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>This property represents the number of infrastructure (e.g., buildings, bridges) has collapsed due to the landslide.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Collapsed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasEvacuated -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasEvacuated">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>This property indicates the number of people evacuated from the area due to the landslide.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Evacuated</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasLat -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasLat">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>This property represents the latitude coordinate of a specific landslide location, expressed as a floating-point number.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Lat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasLon -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasLon">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>This property represents the longitude coordinate of a specific landslide location, expressed as a floating-point number.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Lon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasLossOfLife -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasLossOfLife">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>This property represents the total number of human lives lost due to the landslide.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Loss Of Life</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasPartialDamage -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasPartialDamage">
