        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Partial Damage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasTotalAffected -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasTotalAffected">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/EnvironmentComponentUnionInfrastructureComponentUnionPopulation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>This property indicates the total number of people, animals, or assets affected by the landslide, measured as an integer value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>has Total Affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/hasTotalMonetaryValue -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/hasTotalMonetaryValue">
