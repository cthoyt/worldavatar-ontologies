        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>is Produced By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/managesForecastOf -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/managesForecastOf">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/LandslideForecast"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Landslide"/>
        <rdfs:comment>Links a landslide forecast to the landslide it manages or predicts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>manages Forecast Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/occursOn -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/occursOn">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Landslide"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Slope/Soil/GeologicalLayer"/>
        <rdfs:comment>Indicates the slope, soil, or geological layer on which a landslide occurs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>occurs On</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/reportedBy -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/reportedBy">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/WarningSign"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Person"/>
        <rdfs:comment>Refers to the person who reported a warning sign.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>reported By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/responseBy -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/responseBy">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Response"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/ResponseDepartment"/>
        <rdfs:comment>Refers to the department responsible for the response.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>response By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/usedLogistics -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/usedLogistics">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Response"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/ResponseLogistics"/>
        <rdfs:comment>Denotes the logistics used during the response to a landslide.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>used Logistics</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontolandslide/warnsAbout -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontolandslide/warnsAbout">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/WarningSign"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontolandslide/Landslide"/>
        <rdfs:comment>Indicates the landslide that the warning sign is about.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontolandslide"/>
        <rdfs:label>warns About</rdfs:label>
    </owl:ObjectProperty>
    


