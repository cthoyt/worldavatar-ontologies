    <!-- http://www.theworldavatar.com/kg/ontoearthquake#triggers -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#triggers">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Fire/Flood/Tsunami/Landslide"/>
        <rdfs:comment>Indicates that one event initiates or causes another</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>triggers</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#triggersResponse -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#triggersResponse">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#WarningSystem"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Response"/>
        <rdfs:comment>Specifies that an event triggers a response action.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>triggersResponse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#usedLogistics -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#usedLogistics">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Response"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#ResponseLogistics"/>
        <rdfs:comment>Denotes the logistics used during the response to a earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>used Logistics</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#usesDataFrom -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#usesDataFrom">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#HazardAssessment"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#EarthObservationData"/>
        <rdfs:comment>Connects an input parameter to its data source.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Data Source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#usesGNSS -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#usesGNSS">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#EarthObservationData"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#GNSS"/>
        <rdfs:comment>Indicates the earthquake that the warning sign is about.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>warns About</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#usesInSAR -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#usesInSAR">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#EarthObservationData"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#InSAR"/>
        <rdfs:comment>Links a warning sign to its severity level.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Severity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#usesPreparedness -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#usesPreparedness">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#HazardAssessment"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Preparedness"/>
        <rdfs:comment>Links an entity to preparedness actions or plans utilized during an event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>usesPreparedness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#usesSensor -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#usesSensor">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#EarthObservationData"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Sensor"/>
        <rdfs:comment>Associates a earthquake spot with its current warning sign.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>current Warning Sign</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://seismic.balog.jp/ontology/jp-earthquake.ttl#observedWave -->


    <owl:ObjectProperty rdf:about="https://seismic.balog.jp/ontology/jp-earthquake.ttl#observedWave">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Wave"/>
        <rdfs:comment>defines the observed characteristics or properties of seismic waves associated with an earthquake event, typically involving data related to wave type, speed, frequency, and other measurable parameters relevant to seismic activity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://seismic.balog.jp/ontology/jp-earthquake.ttl#"/>
        <rdfs:label>observedWave</rdfs:label>
    </owl:ObjectProperty>
    


