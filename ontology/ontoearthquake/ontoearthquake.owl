        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Forecast Location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasWaveLength -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasWaveLength">
