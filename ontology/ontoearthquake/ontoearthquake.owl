        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Recovery/Response/Preparedness/HazardAssessment"/>
        <rdfs:comment>Earthquake risk management includes reovery, response, preparedness or hazard assessment</rdfs:comment>
        <rdfs:comment>Links a geological layer to its water content.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>includes</rdfs:label>
