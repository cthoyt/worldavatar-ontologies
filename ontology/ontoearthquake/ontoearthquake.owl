        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Shape File</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasTimeInterval -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasTimeInterval">
