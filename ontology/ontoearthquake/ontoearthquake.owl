        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasVelocity -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasVelocity">
