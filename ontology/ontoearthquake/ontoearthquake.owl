     -->


    


    <!-- http://www.opengis.net/ont/geosparql#Geometry -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
        <rdfs:comment>A class representing geometric shapes or locations as part of the GeoSPARQL ontology.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label>Geometry</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#Accelerometer -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#Accelerometer">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Sensor"/>
        <rdfs:comment>A device that measures the acceleration of ground motion during an earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Warning Sign</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#AfterShock -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#AfterShock">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:comment>A smaller earthquake that follows the main seismic event, occurring in the same area.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>After Shock</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#Air -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#Air">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#EnvironmentComponent"/>
        <rdfs:comment>The atmosphere and its quality as influenced by seismic activities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Air</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#Animal -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#Animal">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#LivingBeing"/>
        <rdfs:comment>Non-human living organisms potentially affected by seismic activities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#AreaInfrastructure -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#AreaInfrastructure">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#InfrastructureComponent"/>
        <rdfs:comment>Regional infrastructure components potentially vulnerable to earthquake damage.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Area Infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#BuildingRetrofitting -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#BuildingRetrofitting">
        <rdfs:comment>The process of strengthening existing buildings to withstand future earthquakes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Building Retrofitting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#CommercialInfrastructure -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#CommercialInfrastructure">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#AreaInfrastructure"/>
        <rdfs:comment>Business-related infrastructure such as shops and offices that may be impacted by an earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Commercial Infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#Community -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#Community">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#ResponseDepartment"/>
        <rdfs:comment>A group of people living in an area impacted or potentially impacted by an earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Community</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#CriticalInfrastructure -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#CriticalInfrastructure">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#AreaInfrastructure"/>
        <rdfs:comment>Essential infrastructure systems like hospitals, energy, and communication systems crucial for earthquake response.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Critical Infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#DamageAssessment -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#DamageAssessment">
        <rdfs:comment>Evaluation of the damage caused by an earthquake to infrastructure, environment, and population.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Damage Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#EarthObservationData -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#EarthObservationData">
        <rdfs:comment>Data collected from satellites and sensors that monitor seismic and geophysical changes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Earth Observation Data</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#Earthquake -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake">
        <rdfs:subClassOf rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Event"/>
        <rdfs:comment>A sudden and violent shaking of the ground, caused by movements within the earth’s crust.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Earthquake</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#EarthquakeHistory -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#EarthquakeHistory">
        <rdfs:comment>A record of past earthquake events, including their properties and impacts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>Earthquake History</rdfs:label>
    </owl:Class>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#EarthquakeRiskManagement -->


    <owl:Class rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#EarthquakeRiskManagement">
