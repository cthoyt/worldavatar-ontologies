<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.theworldavatar.com/kg/ontoearthquake#"
     xml:base="http://www.theworldavatar.com/kg/ontoearthquake"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ontoearthquake="http://www.theworldavatar.com/kg/ontoearthquake#">
    <owl:Ontology rdf:about="http://www.theworldavatar.com/kg/ontoearthquake">
        <dc:date>04 September 2026</dc:date>
        <gitCommitHash>c0599beca8df55873a1ab061dee64e52c510c6a0</gitCommitHash>
        <rdfs:comment>OntoEarthquake is an ontology developed to represent earthquake hazard</rdfs:comment>
        <owl:versionInfo>1</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#gitCommitHash -->


    <owl:AnnotationProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#gitCommitHash"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#actionTaken -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#actionTaken">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Response"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#ResponseAction"/>
        <rdfs:comment>Specifies the actions taken in response to a earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>action Taken</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#affects -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#affects">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Wildfire"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#EnvironmentComponent/InfrastructureComponent/LivingBeing"/>
        <rdfs:comment>Indicates the components (environment, infrastructure, population) affected by an event like a wildfire or earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#assessesFor -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#assessesFor">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#HazardAssessment"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Location"/>
        <rdfs:comment>Relates an assessment process to the object or aspect being evaluated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>assessesFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#collectImpactData -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#collectImpactData">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Response"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#DamageAssessment"/>
        <rdfs:comment>Refers to the collection of data related to the impact of an event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>collectImpactData</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#detectedBy -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#detectedBy">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Hypocenter/Epicenter"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#SeismicStation"/>
        <rdfs:comment>Hypocenter or edicenter is detected by the seismic station</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>detected By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#generates -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#generates">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#HazardAssessment"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#SeismicHazardForecast"/>
        <rdfs:comment>Identifies the input parameters used for earthquake forecasting.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Input Parameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasBeginning -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasBeginning">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Interval"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Instant"/>
        <rdfs:comment>Defines the starting instant of an interval.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Beginning</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasEarthquakeHistory -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasEarthquakeHistory">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Location"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#EarthquakeHistory"/>
        <rdfs:comment>Describes the historical data of earthquakes associated with a location.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Earthquake History</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasEnd -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasEnd">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Interval"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Instant"/>
        <rdfs:comment>Defines the ending instant of an interval.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has End</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasEpicenter -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasEpicenter">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Epicenter"/>
        <rdfs:comment>Relates an earthquake to its epicenter, the point on the Earth&apos;s surface above the hypocenter.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Epicenter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasFileUrl -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasFileUrl">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#ShapeFile"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#FileUrl"/>
        <rdfs:comment>Points to the URL of the shapefile.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has File Url</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasFrequency -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasFrequency">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Wave"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Oscillations"/>
        <rdfs:comment>Defines the frequency of a wave.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Frequency</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasGeometry -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasGeometry">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Location"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment>Indicates the geometric representation of a location.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Geometry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasHypocenter -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasHypocenter">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Hypocenter"/>
        <rdfs:comment>Links an earthquake to its hypocenter, the point where the rupture starts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Hypocenter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasLocation -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasLocation">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#SeismicStationORHypocenterOREpicenter"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Location"/>
        <rdfs:comment>Links an event to the geographic location where it occurred.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasMitigationStrategy -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasMitigationStrategy">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Preparedness"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#MitigationStrategy"/>
        <rdfs:comment>Links a earthquake forecast to the earthquake it manages or predicts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>manages Forecast Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasRiskLevel -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasRiskLevel">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#SeismicHazardForecast"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#RiskLevel"/>
        <rdfs:comment>Refers to the person who reported a warning sign.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>reported By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasSeismicStation -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasSeismicStation">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#SeismicStation"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Location"/>
        <rdfs:comment>Associates an earthquake or observation with the seismic station that recorded it.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Seismic Station</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasShapeFile -->


    <owl:ObjectProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasShapeFile">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Location"/>
        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#ShapeFile"/>
