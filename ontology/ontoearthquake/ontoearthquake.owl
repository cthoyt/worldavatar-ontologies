        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Collapsed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasDamagedRadius -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasDamagedRadius">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>hasDamagedRadius: Specifies the radius within which structural damage occurred due to the earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Damaged Radius </rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasDepth -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasDepth">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Specifies the depth at which the earthquake originates beneath the Earth&apos;s surface.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Depth</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasEvacuated -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasEvacuated">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>This property indicates the number of people evacuated from the area due to the earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Evacuated</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasFeltRadius -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasFeltRadius">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Defines the radius around the epicenter where the earthquake is perceptible.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Felt Radius</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasLat -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasLat">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>This property represents the latitude coordinate of a specific earthquake location, expressed as a floating-point number.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Lat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasLon -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasLon">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>This property represents the longitude coordinate of a specific earthquake location, expressed as a floating-point number.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Lon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasLossOfLife -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasLossOfLife">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>This property represents the total number of human lives lost due to the earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Loss Of Life</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasMercalliIntensity -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasMercalliIntensity">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Denotes the earthquake&apos;s intensity as perceived by people, using the Mercalli Intensity Scale.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>hasMercalliIntensity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasMomentMagnitude -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasMomentMagnitude">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Indicates the earthquake&apos;s magnitude based on the seismic moment (energy released).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Moment Magnitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasPartialDamage -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasPartialDamage">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#InfrastructureComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>This property represents the number of infrastructure or assets have sustained partial damage from the earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Partial Damage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasRichterScale -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasRichterScale">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#Earthquake"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Represents the magnitude of the earthquake as measured by the Richter scale.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Richter Scale</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasTotalAffected -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasTotalAffected">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#EnvironmentComponent/InfrastructureComponent/LivingBeing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>This property indicates the total number of people, animals, or assets affected by the earthquake, measured as an integer value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Total Affected</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasTotalMonetaryValue -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasTotalMonetaryValue">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#EnvironmentComponent/InfrastructureComponent/LivingBeing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>This property represents the total financial loss or damage caused by the earthquake, expressed as a monetary value.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Total Monetary Value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#inDanger -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#inDanger">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#EnvironmentComponentUnionInfrastructureComponentUnionPopulation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>This property indicates the number of people or assets currently at risk due to the earthquake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>in Danger</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.theworldavatar.com/kg/ontoearthquake#lastUpdateOn -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#lastUpdateOn">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#ShapeFile"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>This property represents the timestamp of the most recent update related to the earthquake situation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>last Update On</rdfs:label>
    </owl:DatatypeProperty>
    


