    <!-- http://www.theworldavatar.com/kg/ontoearthquake#hasCollapsed -->


    <owl:DatatypeProperty rdf:about="http://www.theworldavatar.com/kg/ontoearthquake#hasCollapsed">
        <rdfs:domain rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#InfrastructureComponent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
