        <rdfs:range rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake#TimeSeries"/>
        <rdfs:comment>hasTimeSeries: Links data to its time series, providing sequential time-based information</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.theworldavatar.com/kg/ontoearthquake"/>
        <rdfs:label>has Time Series</rdfs:label>
    </owl:ObjectProperty>
    


